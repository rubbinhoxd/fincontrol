# Chave da API do Claude (Anthropic Console) — compartilhada por todos os users
ANTHROPIC_API_KEY=sk-ant-api03-COLOQUE_SUA_CHAVE_AQUI
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# URL da fincontrol-api (rede interna docker)
FINCONTROL_API_URL=http://api:8080/api

# Secret compartilhado com a API Java. Usado pelo bot pra pedir JWT em nome de
# um usuario via POST /api/internal/service-token, e pra autenticar as chamadas
# do Java pra API interna do bot (Bearer no header).
# Gere com: openssl rand -base64 48
INTERNAL_SHARED_SECRET=

# Porta da API HTTP interna do bot (so exposta na rede docker)
PORT=3000

# Diretorio raiz de auth do Baileys. Cada usuario tem sua subpasta: <AUTH_DIR>/<user_id>/
AUTH_DIR=/app/auth_info

# info | debug | warn | error
LOG_LEVEL=info
