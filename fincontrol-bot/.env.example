# Chave da API do Claude (Anthropic Console)
# Nao commite esse arquivo com a chave real
ANTHROPIC_API_KEY=sk-ant-api03-COLOQUE_SUA_CHAVE_AQUI
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# URL da fincontrol-api. Se rodando via docker-compose, deixe assim.
FINCONTROL_API_URL=http://api:8080/api

# Credenciais do usuario do FinControl (o bot faz login para criar transacoes)
FINCONTROL_EMAIL=seu-email@exemplo.com
FINCONTROL_PASSWORD=sua-senha

# JID do grupo autorizado. Deixe VAZIO na primeira execucao para descobrir:
# 1. Suba o bot: docker compose up -d bot
# 2. Escaneie o QR: docker compose logs -f bot
# 3. Crie um grupo dedicado no WhatsApp (pode ser so voce)
# 4. Mande uma mensagem qualquer no grupo
# 5. Veja o JID no log ([SETUP] Mensagem recebida em JID: ...)
# 6. Cole aqui e reinicie: docker compose restart bot
ALLOWED_JID=

# info | debug | warn | error
LOG_LEVEL=info
